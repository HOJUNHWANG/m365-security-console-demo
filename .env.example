# Entra app registration values - fill these in after registering the app.
# Important: copy this file to .env and put the real values there.
#            Never commit .env to git (it is in .gitignore).
#            Never paste a client secret into chat, documents or code.

TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# === Exchange Online PowerShell (optional - for the Mail Security tab collector) ===
# Fill these in after uploading a certificate to the same app registration, granting
# Exchange.ManageAsApp, and assigning a read role such as Global Reader.
# Keep the certificate itself in the Windows certificate store (CurrentUser\My);
# only the thumbprint goes here.
EXO_ORG=yourtenant.onmicrosoft.com
EXO_CERT_THUMBPRINT=

# === Groq AI security summary (optional) ===
# With a key set, each collection sends aggregate metrics (non-PII) to Groq to generate a
# summary. Leave it empty to disable the feature entirely.
# Keep the key in .env only - never share it in chat or anywhere external.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Spoofing quarantine / redirect mailboxes (optional, comma-separated) - excluded from the
# "delivered threats" list and counted separately. Example: spoof-quarantine@example.com
HUNT_QUARANTINE_MAILBOXES=

# Own domains - mail from these that is not allowlisted is labelled own-domain spoofing. Example: contoso.com
HUNT_OWN_DOMAINS=
# Allowlist - treated as normal, no alert even when flagged as spam. Comma-separated.
# Best kept in sync with your anti-spam allowed domains/senders policy. Example: affiliate.com,partner.com
HUNT_ALLOWLIST_DOMAINS=
HUNT_ALLOWLIST_SENDERS=
